# Copiar este archivo como .env y completar con los valores reales.
# El .env no se sube al repositorio.

# Usuario y contraseña de MySQL
DB_USUARIO=root
DB_CLAVE=

# Firma de los tokens. Tiene que ser la misma cadena en usuarios-service
# y en api-gateway, y de al menos 32 caracteres.
JWT_SECRETO=
